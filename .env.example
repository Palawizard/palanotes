# Database. With compose.yaml, DATABASE_URL is built from POSTGRES_PASSWORD.
DATABASE_URL=postgres://palanotes:palanotes@localhost:5434/palanotes
# Production only: hex characters, for example `openssl rand -hex 24`
POSTGRES_PASSWORD=

# Application
PUBLIC_URL=http://localhost:3000
BASE_PATH=/notes
SESSION_SECRET=

# Sign-in (Authentik, OIDC)
OIDC_ISSUER=https://auth.palawi.fr/application/o/palanotes/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/notes/api/auth/callback

# Language model
# Mode for every account except the owner: api or disabled
LLM_DEFAULT_MODE=disabled
# Mode for the owner: subscription, api or disabled
LLM_OWNER_MODE=subscription
# OIDC subject (sub) of the owner, the only account allowed to use the subscription
LLM_OWNER_SUBJECT=
# Subscription mode: token created with `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=
# Api mode: key from the Anthropic console (set a monthly spending limit there)
ANTHROPIC_API_KEY=
# Model id for both modes, default claude-haiku-5-5
LLM_MODEL=
# Subscription mode: path of the claude binary and its private config directory
CLAUDE_CLI_PATH=
CLAUDE_CLI_CONFIG_DIR=
# Development only: 1 files every entry with a fake model (refused when NODE_ENV=production)
LLM_FAKE=0

# Production only (compose.yaml)
# External Docker network shared with the reverse proxy
PROXY_NETWORK=proxy
# Image tag built and run by compose
PALANOTES_TAG=local
