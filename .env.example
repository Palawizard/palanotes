# Base de données
DATABASE_URL=postgres://palanotes:palanotes@localhost:5434/palanotes

# Application
PUBLIC_URL=http://localhost:3000
BASE_PATH=/notes
SESSION_SECRET=

# Connexion (Authentik, OIDC)
OIDC_ISSUER=https://auth.palawi.fr/application/o/palanotes/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/notes/api/auth/callback

# Modèle de langage
# LLM_DEFAULT_MODE : mode des comptes qui ne sont pas le propriétaire (api ou disabled)
LLM_DEFAULT_MODE=disabled
# LLM_OWNER_MODE : mode du propriétaire (subscription, api ou disabled)
LLM_OWNER_MODE=subscription
# Sujet OIDC (sub) du propriétaire, seul compte autorisé à passer par l'abonnement
LLM_OWNER_SUBJECT=
# Mode abonnement : jeton créé par `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=
# Mode api : clé de la console Anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=
